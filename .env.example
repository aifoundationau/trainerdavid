# Environment Configuration Template for Trainer David Web Application
VITE_APP_TITLE="Trainer David - Online Personal Training & Coaching"
VITE_API_BASE_URL="http://localhost:3000/api"
VITE_APP_ENV="development"

# Google Authentication (OAuth 2.0 Client ID)
VITE_GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# Stripe Payment Gateway (Sandbox / Test Mode)
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"

# Google Gemini AI & RAG Configuration
GEMINI_API_KEY="your-gemini-api-key"
VITE_GEMINI_API_KEY="your-gemini-api-key"
GEMINI_PROJECT_ID="projects/your-project-id"
GEMINI_PROJECT_NUMBER="your-project-number"

# Firebase web config (public values)
VITE_FIREBASE_API_KEY="your-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"
VITE_FIRESTORE_DATABASE_ID="trainerdavid"

# Firestore database ID (server-side, for Admin SDK and REST)
FIRESTORE_DATABASE_ID="trainerdavid"

# Google Drive uploads (admin panel → Upload). Server-only: never prefix these with VITE_.
# ROOT_FOLDER_ID: a Shared Drive or a folder inside one, shared with the service account as Content manager.
ROOT_FOLDER_ID="your-shared-drive-or-folder-id"
# Either the whole service account key JSON on one line...
GOOGLE_SERVICE_ACCOUNT=""
# ...or its client_email and private_key fields
GOOGLE_CLIENT_EMAIL="uploader@your-project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
